<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SyncNote" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#3F51B5</item>
        <item name="colorPrimaryDark">#303F9F</item>
        <item name="colorAccent">#FF4081</item>
    </style>

    <!-- Изолированная MDC-тема только для новых экранов файлов (этап F.7).
         Основная тема приложения не меняется. -->
    <style name="Theme.SyncNote.Files" parent="Theme.MaterialComponents.Light.Bridge">
        <item name="colorPrimary">@color/files_accent</item>
        <item name="colorPrimaryDark">@color/files_accent_dark</item>
        <item name="colorSecondary">@color/files_accent</item>
        <item name="colorAccent">@color/files_accent</item>
    </style>

    <style name="Theme.SyncNote.FilesBottomSheet"
        parent="Theme.MaterialComponents.Light.BottomSheetDialog">
        <item name="colorPrimary">@color/files_accent</item>
        <item name="colorSecondary">@color/files_accent</item>
    </style>
</resources>
