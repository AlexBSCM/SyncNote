<?xml version="1.0" encoding="utf-8"?>
<!-- Primary-кнопка: индиго; при нажатии темнее (аналог hover на Desktop).
     AppCompat-безопасный вариант: только android:* атрибуты + shape. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/sync_accent_dark" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/sync_accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
