<?xml version="1.0" encoding="utf-8"?>
<!-- Обычная кнопка: белая заливка + рамка; при нажатии подложка темнее.
     AppCompat-безопасный вариант: только android:* атрибуты + shape. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_hover" />
            <stroke
                android:width="1dp"
                android:color="@color/border_line" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke
                android:width="1dp"
                android:color="@color/border_line" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
