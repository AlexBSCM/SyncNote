<?xml version="1.0" encoding="utf-8"?>
<!-- Smart Start Screen (бэклог 1.c): точка входа приложения.
     Показывается, только если нет доверенных устройств.
     Прямая копия шапки вкладок не используется — AppStartActivity
     владеет этим экраном целиком. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_window">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/sync_accent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SyncNote"
            android:textColor="@color/text_on_accent"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Подключение"
            android:textColor="@color/text_on_accent"
            android:textSize="13sp"
            android:alpha="0.85" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Container A: список доверенных ПК -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/devicesList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <!-- Container B: пустое состояние с призывом сканировать QR -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="56sp"
                android:alpha="0.3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Нет подключенных устройств"
                android:textAppearance="@style/TextAppearance.SyncNote.Title"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Откройте SyncNote на компьютере и нажмите «Сопряжение», затем отсканируйте код камерой."
                android:textAppearance="@style/TextAppearance.SyncNote.Body"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/scanQrButton"
                style="@style/Widget.SyncNote.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minWidth="0dp"
                android:text="📷 Сканировать QR-код"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/manualEntryButton"
                style="@style/Widget.SyncNote.Button.Default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Ввести адрес вручную"
                android:textAllCaps="false" />
        </LinearLayout>

        <!-- Статус операции подключения -->
        <LinearLayout
            android:id="@+id/connectingBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/connectingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SyncNote.Body"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/connectingProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/sync_accent" />
        </LinearLayout>

        <!-- Footer: добавить новое устройство -->
        <Button
            android:id="@+id/addDeviceButton"
            style="@style/Widget.SyncNote.Button.Default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:text="+ Добавить новое устройство"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
