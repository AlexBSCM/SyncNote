<?xml version="1.0" encoding="utf-8"?>
<!-- Строка вложения в редакторе (бэклог 1.d).
     Карточка: иконка по MIME + имя + мета, ниже три действия.
     Открыть/Скачать/Удалить сохранены — они реально работают. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_card"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/attachIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:textSize="18sp"
            android:text="📎"
            android:background="@drawable/bg_badge_default" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SyncNote.Title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/fileMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.SyncNote.Caption"
                android:textColor="@color/text_hint"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOpen"
            style="@style/Widget.SyncNote.Button.Default"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="13sp"
            android:text="Открыть"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnSave"
            style="@style/Widget.SyncNote.Button.Default"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="13sp"
            android:text="Скачать"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnDelete"
            style="@style/Widget.SyncNote.Button.Danger"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="13sp"
            android:text="Удалить"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
