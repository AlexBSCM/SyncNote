<?xml version="1.0" encoding="utf-8"?>
<!-- Элемент списка конфликтов: карточка с заголовком и двумя версиями.
     Замена android.R.layout.simple_list_item_1 (бэклог 1.b) —
     тот системный layout не позволял применить дизайн-систему.
     Левая колонка = локальная (текущая) заметка, правая = копия с ПК. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_card"
    android:padding="16dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/pairTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.SyncNote.Title"
        android:textColor="@color/text_primary"
        android:maxLines="1"
        android:ellipsize="middle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/localLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="МОЯ"
                android:textAppearance="@style/TextAppearance.SyncNote.Caption"
                android:textColor="@color/text_hint"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/localPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.SyncNote.Body"
                android:textColor="@color/text_secondary"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:background="@color/border_line" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/remoteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="С ПК"
                android:textAppearance="@style/TextAppearance.SyncNote.Caption"
                android:textColor="@color/text_hint"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/remotePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.SyncNote.Body"
                android:textColor="@color/text_secondary"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/pairDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.SyncNote.Caption"
        android:textColor="@color/text_hint" />
</LinearLayout>
