<Window x:Class="SyncNote.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SyncNote" Height="560" Width="880" MinHeight="420" MinWidth="660">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/FilesTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="ConnectionStatus" Text="Не подключено" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ConflictsButton" Content="Конфликты (0)" Padding="8,0"
                            Visibility="Collapsed" Click="ConflictsButton_Click" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
        <TabControl x:Name="MainTabs">
            <TabItem Header="Заметки">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="8">
                        <TextBlock DockPanel.Dock="Top" Text="Поиск" Margin="0,0,0,4" />
                        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                                 TextChanged="SearchBox_TextChanged" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="AddButton" Content="Добавить" Width="100"
                                    Click="AddButton_Click" />
                            <Button x:Name="DeleteButton" Content="Удалить" Width="100" Margin="8,0,0,0"
                                    Click="DeleteButton_Click" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox x:Name="SelectAllNotesBox" Content="Выбрать все"
                                      VerticalAlignment="Center"
                                      Checked="SelectAllNotesBox_Changed"
                                      Unchecked="SelectAllNotesBox_Changed" />
                            <Button x:Name="DeleteCheckedButton" Content="Удалить выбранные"
                                    Margin="8,0,0,0" Click="DeleteChecked_Click" />
                        </StackPanel>
                        <ListBox x:Name="NotesList" SelectionChanged="NotesList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center" />
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Note.Title}" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Note.UpdatedAt, StringFormat=g}"
                                                       Opacity="0.6" FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel Grid.Column="1" Margin="8">
                        <TextBlock x:Name="EmptyHint" Text="Выберите заметку в списке или нажмите «Добавить»."
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="EditorPanel" Visibility="Collapsed">
                                <TextBlock Text="Заголовок" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,8">
                                    <TextBox x:Name="TitleBox" TextChanged="TitleBox_TextChanged" />
                                    <TextBlock x:Name="TitleWatermark" Text="Заголовок"
                                               Opacity="0.5" Margin="4,2,0,0" IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Текст" VerticalAlignment="Center" />
                                    <CheckBox x:Name="PreviewCheck" Content="Предпросмотр" Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              Checked="PreviewCheck_Toggled"
                                              Unchecked="PreviewCheck_Toggled" />
                                </StackPanel>
                                <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" Height="200"
                                         TextChanged="BodyBox_TextChanged" />
                                <ScrollViewer x:Name="PreviewScroll" MaxHeight="200"
                                              Visibility="Collapsed" Margin="0,4,0,0">
                                    <TextBlock x:Name="PreviewBlock" TextWrapping="Wrap" />
                                </ScrollViewer>
                                <TextBlock Text="Чек-лист" Margin="0,8,0,4" />
                                <ListBox x:Name="ChecklistBox" MaxHeight="140">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <CheckBox IsChecked="{Binding IsChecked}"
                                                          Tag="{Binding Id}"
                                                          Checked="ChecklistItem_Toggled"
                                                          Unchecked="ChecklistItem_Toggled"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" Margin="6,0"
                                                           VerticalAlignment="Center" MaxWidth="320"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Content="×" Tag="{Binding Id}" Width="24"
                                                        Click="DeleteChecklistItem_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBox x:Name="NewItemBox" Width="280" />
                                    <Button Content="В список" Margin="8,0,0,0"
                                            Click="AddChecklistItem_Click" />
                                </StackPanel>
                                <TextBlock Text="Вложения" Margin="0,8,0,4" />
                                <ListBox x:Name="AttachmentsBox" MaxHeight="100">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding FileName}" MaxWidth="200"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SizeBytes, StringFormat='{}{0} байт'}"
                                                           Opacity="0.6" FontSize="11" Margin="6,0"
                                                           VerticalAlignment="Center" />
                                                <Button Content="Открыть" Tag="{Binding Id}" Width="60"
                                                        Click="OpenAttachment_Click" />
                                                <Button Content="Скачать" Tag="{Binding Id}" Width="60" Margin="4,0,0,0"
                                                        Click="DownloadAttachment_Click" />
                                                <Button Content="×" Tag="{Binding Id}" Width="24" Margin="4,0,0,0"
                                                        Click="DeleteAttachment_Click" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="Добавить файл…" Width="120" Margin="0,4,0,0"
                                        HorizontalAlignment="Left" Click="AddAttachment_Click" />
                                <Button x:Name="SaveButton" Content="Сохранить" Width="100"
                                        Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Click="SaveButton_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Файлы" x:Name="FilesTab" FontFamily="Segoe UI">
                <TabItem.Resources>
                    <BooleanToVisibilityConverter x:Key="BoolToVis" />
                </TabItem.Resources>
                <Grid>
                <Grid x:Name="FilesContent" Background="{StaticResource FilesPanelBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource FilesPanelBrush}"
                            BorderBrush="{StaticResource FilesLineBrush}"
                            BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="12"
                                BorderBrush="{StaticResource FilesLineSoftBrush}"
                                BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="170" Style="{StaticResource FilesSearchBox}"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="＋ Добавить" Margin="8,0,0,0"
                                        Style="{StaticResource FilesBtnPrimary}"
                                        Command="{Binding AddCommand}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="FilesEmptyHint" Text="Файлов пока нет."
                                   Foreground="{StaticResource FilesTxt2Brush}" FontSize="13"
                                   Margin="16,12,0,0"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <ListBox Style="{StaticResource FilesList}"
                                 ItemsSource="{Binding FilesList}"
                                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource FilesListItem}"
                                 Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8"
                                                Background="{StaticResource FilesPanel2Brush}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayIcon}" FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource FilesTxtBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MetaLine}" FontSize="11"
                                                       Margin="0,2,0,0"
                                                       Foreground="{StaticResource FilesTxt3Brush}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="10" Padding="8,3"
                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource FilesOkBgBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource FilesWarnBgBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource FilesErrBgBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusBadgeText}"
                                                       FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource FilesOkFgBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource FilesWarnFgBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource FilesErrBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    </Border>

                    <DockPanel Grid.Column="1" Background="{StaticResource FilesPanelBrush}">
                        <Border DockPanel.Dock="Top" Padding="24,24,24,16"
                                BorderBrush="{StaticResource FilesLineSoftBrush}"
                                BorderThickness="0,0,0,1">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="64" Height="64"
                                        CornerRadius="12"
                                        Background="{StaticResource FilesPanel2Brush}"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding SelectedFile.DisplayIcon}" FontSize="32"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedFile.Name}" FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource FilesTxtBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13"
                                               Foreground="{StaticResource FilesTxt2Brush}">
                                        <Run Text="{Binding SelectedFile.Mime, Mode=OneWay}" />
                                        <Run Text=" • " />
                                        <Run Text="{Binding SelectedFile.FormattedSize, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border DockPanel.Dock="Bottom" Background="{StaticResource FilesPanel2Brush}"
                                BorderBrush="{StaticResource FilesLineSoftBrush}"
                                BorderThickness="0,1,0,0" Padding="24,16">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Открыть" Style="{StaticResource FilesBtnPrimary}"
                                        Command="{Binding OpenCommand}" />
                                <Button Content="Сохранить как..." Margin="10,0,0,0"
                                        Style="{StaticResource FilesBtnDefault}"
                                        Command="{Binding SaveAsCommand}" />
                                <Button Content="Удалить" Margin="10,0,0,0"
                                        Style="{StaticResource FilesBtnDanger}"
                                        Command="{Binding DeleteCommand}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="24" Background="{StaticResource FilesPanel2Brush}"
                                BorderBrush="{StaticResource FilesLineBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Rectangle Stroke="{StaticResource FilesLineBrush}"
                                           StrokeThickness="1" StrokeDashArray="5,4"
                                           RadiusX="10" RadiusY="10" Margin="1" />
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                       Margin="16" />
                                <TextBlock Text="Предпросмотр недоступен"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{StaticResource FilesTxt3Brush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImagePreview}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel VerticalAlignment="Bottom"
                                            Background="{StaticResource FilesSpoilerOverlayBrush}">
                                    <Button Content="{Binding SpoilerHeader}"
                                            Command="{Binding ToggleSpoilerCommand}"
                                            Style="{StaticResource FilesSpoilerToggle}"
                                            HorizontalContentAlignment="Left" Height="32" />
                                    <Border BorderBrush="{StaticResource FilesLineBrush}"
                                            BorderThickness="0,1,0,0" Padding="12,0,12,12"
                                            Background="{StaticResource FilesPanelBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSpoilerOpen}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SelectedFile.FullInfo}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource FilesTxt2Brush}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DockPanel>
                </Grid>
                <TextBlock x:Name="FilesDisabledHint"
                           Text="Отдельные файлы отключены флагом EnableSeparateFiles."
                           Foreground="{StaticResource FilesTxt2Brush}" FontSize="13"
                           Margin="12" VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed" />
                </Grid>
            </TabItem>
            <TabItem Header="Настройки">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Text="Синхронизация" FontWeight="Bold" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Узел" VerticalAlignment="Center" />
                            <TextBox x:Name="SyncHostBox" Text="127.0.0.1" Grid.Column="1" Margin="0,2" />
                            <TextBlock Text="Порт" Grid.Row="1" VerticalAlignment="Center" />
                            <TextBox x:Name="SyncPortBox" Text="48211" Grid.Row="1" Grid.Column="1" Margin="0,2" />
                            <TextBlock Text="Токен" Grid.Row="2" VerticalAlignment="Center" />
                            <TextBox x:Name="SyncTokenBox" Grid.Row="2" Grid.Column="1" Margin="0,2" />
                            <TextBlock Text="Имя" Grid.Row="3" VerticalAlignment="Center" />
                            <TextBox x:Name="SyncDeviceBox" Grid.Row="3" Grid.Column="1" Margin="0,2" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="SyncGoButton" Content="Синхронизировать" Width="140"
                                    Click="SyncGoButton_Click" />
                            <Button x:Name="SyncCancelButton" Content="Отмена" Width="90" Margin="8,0,0,0"
                                    IsEnabled="False" Click="SyncCancelButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="SyncStateText" Text="Не подключено" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock Text="Сопряжение" FontWeight="Bold" Margin="0,12,0,4" />
                        <TextBlock Text="Покажите QR-код на телефоне в приложении SyncNote."
                                   TextWrapping="Wrap" Margin="0,0,0,4" />
                        <Image x:Name="PairQrImage" Width="200" Height="200" Margin="0,0,0,4"
                               HorizontalAlignment="Left" />
                        <TextBlock x:Name="PairTokenInfo" TextWrapping="Wrap" Opacity="0.7" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Новый код" Width="110" Click="PairNewToken_Click" />
                            <Button x:Name="P2pButton" Content="Создать Wi-Fi Direct группу" Width="220"
                                    Margin="8,0,0,0" Click="P2pButton_Click" />
                            <Button x:Name="BtButton" Content="Принимать по Bluetooth" Width="180"
                                    Margin="8,0,0,0" Click="BtButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="PairServerInfo" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="P2pInfo" TextWrapping="Wrap" Opacity="0.7" />
                        <TextBlock x:Name="BtInfo" TextWrapping="Wrap" Opacity="0.7" />
                        <TextBlock Text="Хранилище" FontWeight="Bold" Margin="0,12,0,0" />
                        <TextBlock x:Name="StorageInfo" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Доверенные устройства" FontWeight="Bold" Margin="0,12,0,4" />
                        <ListBox x:Name="TrustedBox" MaxHeight="120">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <StackPanel Width="300">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DeviceId}" Opacity="0.6" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Content="Отозвать" Tag="{Binding DeviceId}"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                Click="Untrust_Click" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Заметки в базе" FontWeight="Bold" Margin="0,12,0,4" />
                        <TextBlock Text="Управление заметками — во вкладке «Заметки» (галочки, «Выбрать все»)."
                                   TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
