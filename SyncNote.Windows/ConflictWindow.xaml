<Window x:Class="SyncNote.Windows.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Конфликты синхронизации" Height="480" Width="720">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="PairsList" Grid.Column="0" Margin="0,0,8,0"
                 SelectionChanged="PairsList_SelectionChanged" />
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                       Text="Обе версии сохранены. Выберите, что оставить. До решения конфликт остаётся видимым." />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Оставить текущую" Width="130" Click="KeepOriginal_Click" />
                <Button Content="Взять копию" Width="110" Margin="8,0,0,0" Click="TakeCopy_Click" />
                <Button Content="Оставить обе" Width="110" Margin="8,0,0,0" Click="KeepBoth_Click" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Текущая версия" FontWeight="Bold" />
                    <TextBox x:Name="OriginalBox" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Height="300" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Копия с другого устройства" FontWeight="Bold" />
                    <TextBox x:Name="CopyBox" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Height="300" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
