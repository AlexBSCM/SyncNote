<Application x:Class="SyncNote.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SyncNote.Windows"
             StartupUri="MainWindow.xaml">
    <!-- Дизайн-система: полная тема FilesTheme доступна глобально.
         Окна со своим MergedDictionaries продолжают работать без изменений
         (локальные ресурсы имеют приоритет). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/FilesTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
