<Window x:Class="SyncNote.Windows.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сопряжение" Height="520" Width="420">
    <StackPanel Margin="12">
        <TextBlock Text="Покажите QR-код на телефоне в приложении SyncNote."
                   TextWrapping="Wrap" Margin="0,0,0,8" />
        <Image x:Name="QrImage" Width="240" Height="240" Margin="0,0,0,8" />
        <TextBlock x:Name="TokenInfo" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="NewTokenButton" Content="Новый код" Width="110"
                    Click="NewTokenButton_Click" />
            <Button x:Name="StartStopButton" Content="Принимать подключения" Width="170"
                    Margin="8,0,0,0" Click="StartStopButton_Click" />
        </StackPanel>
        <TextBlock x:Name="ServerInfo" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Text="Доверенные устройства:" FontWeight="Bold" Margin="0,0,0,4" />
        <ListBox x:Name="TrustedList" MaxHeight="140">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="220">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DeviceId}" Opacity="0.6" FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Content="Отозвать" Tag="{Binding DeviceId}" Margin="8,0,0,0"
                                VerticalAlignment="Center" Click="Untrust_Click" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="Петля 127.0.0.1 — для локальной проверки. Wi-Fi Direct — на реальном железе (см. docs/architecture.md)."
                   TextWrapping="Wrap" Opacity="0.6" Margin="0,8,0,0" />
    </StackPanel>
</Window>
