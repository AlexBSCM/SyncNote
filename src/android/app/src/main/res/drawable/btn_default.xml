<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/files_bg2" />
            <stroke android:width="1dp" android:color="@color/files_accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/files_bg" />
            <stroke android:width="1dp" android:color="@color/files_line" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
