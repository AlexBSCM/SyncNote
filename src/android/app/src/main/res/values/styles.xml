<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Стили v2: зеркало десктопных FilesBtnPrimary/FilesBtnDefault,
         SectionTitle и шкалы 20/14/12. Шрифт — системный Roboto. -->

    <style name="Widget.SyncNote.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.SyncNote.Button.Default" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_default</item>
        <item name="android:textColor">@color/files_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="TextAppearance_SyncNote_Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/files_text</item>
    </style>

    <style name="TextAppearance_SyncNote_Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/files_text</item>
    </style>

    <style name="TextAppearance_SyncNote_Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/files_text2</item>
    </style>
</resources>
