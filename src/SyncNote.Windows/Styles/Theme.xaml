<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:SyncNote.Windows.Views">

    <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- Палитра SyncNote v2: зеркало v1 FilesTheme.xaml. Весь hex — только здесь. -->

    <Color x:Key="FilesAccent">#3F51B5</Color>
    <Color x:Key="FilesAccentHover">#354499</Color>
    <Color x:Key="FilesAccentSoft">#1A3F51B5</Color>
    <Color x:Key="FilesPanel">#FFFFFF</Color>
    <Color x:Key="FilesPanel2">#F7F7F8</Color>
    <Color x:Key="FilesLine">#E2E2E6</Color>
    <Color x:Key="FilesLineSoft">#EDEDF0</Color>
    <Color x:Key="FilesTxt">#1B1B1F</Color>
    <Color x:Key="FilesTxt2">#6A6A72</Color>
    <Color x:Key="FilesTxt3">#9A9AA2</Color>
    <Color x:Key="FilesOk">#2E9E4F</Color>
    <Color x:Key="FilesOkBg">#262E9E4F</Color>
    <Color x:Key="FilesOkFg">#1C7A39</Color>
    <Color x:Key="FilesWarn">#E8A317</Color>
    <Color x:Key="FilesWarnBg">#26E8A317</Color>
    <Color x:Key="FilesWarnFg">#9A6B00</Color>
    <Color x:Key="FilesErr">#D63B3B</Color>
    <Color x:Key="FilesErrBg">#1AD63B3B</Color>

    <SolidColorBrush x:Key="FilesAccentBrush" Color="{StaticResource FilesAccent}" />
    <SolidColorBrush x:Key="FilesAccentHoverBrush" Color="{StaticResource FilesAccentHover}" />
    <SolidColorBrush x:Key="FilesAccentSoftBrush" Color="{StaticResource FilesAccentSoft}" />
    <SolidColorBrush x:Key="FilesPanelBrush" Color="{StaticResource FilesPanel}" />
    <SolidColorBrush x:Key="FilesPanel2Brush" Color="{StaticResource FilesPanel2}" />
    <SolidColorBrush x:Key="FilesLineBrush" Color="{StaticResource FilesLine}" />
    <SolidColorBrush x:Key="FilesLineSoftBrush" Color="{StaticResource FilesLineSoft}" />
    <SolidColorBrush x:Key="FilesTxtBrush" Color="{StaticResource FilesTxt}" />
    <SolidColorBrush x:Key="FilesTxt2Brush" Color="{StaticResource FilesTxt2}" />
    <SolidColorBrush x:Key="FilesTxt3Brush" Color="{StaticResource FilesTxt3}" />
    <SolidColorBrush x:Key="FilesOkBgBrush" Color="{StaticResource FilesOkBg}" />
    <SolidColorBrush x:Key="FilesOkFgBrush" Color="{StaticResource FilesOkFg}" />
    <SolidColorBrush x:Key="FilesWarnBgBrush" Color="{StaticResource FilesWarnBg}" />
    <SolidColorBrush x:Key="FilesWarnFgBrush" Color="{StaticResource FilesWarnFg}" />
    <SolidColorBrush x:Key="FilesErrBrush" Color="{StaticResource FilesErr}" />
    <SolidColorBrush x:Key="FilesErrBgBrush" Color="{StaticResource FilesErrBg}" />
    <SolidColorBrush x:Key="FilesSpoilerOverlayBrush" Color="#F2FFFFFF" />

    <!-- Поиск в тулбаре: padding 8x10, radius 6, фокус акцентом. -->
    <Style x:Key="FilesSearchBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource FilesTxtBrush}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{StaticResource FilesLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource FilesPanelBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource FilesAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Базовый каркас кнопок: flat, radius 6, padding 8x16. -->
    <Style x:Key="FilesBtnBase" TargetType="Button">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary: индиго, hover темнее. -->
    <Style x:Key="FilesBtnPrimary" TargetType="Button"
           BasedOn="{StaticResource FilesBtnBase}">
        <Setter Property="Background" Value="{StaticResource FilesAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FilesAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource FilesAccentHoverBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource FilesAccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Обычная: белый фон, серая рамка, hover акцентом. -->
    <Style x:Key="FilesBtnDefault" TargetType="Button"
           BasedOn="{StaticResource FilesBtnBase}">
        <Setter Property="Background" Value="{StaticResource FilesPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FilesLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource FilesTxtBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource FilesAccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource FilesAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger: прозрачная, красная; hover — красная рамка и фон. -->
    <Style x:Key="FilesBtnDanger" TargetType="Button"
           BasedOn="{StaticResource FilesBtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource FilesErrBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource FilesErrBgBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource FilesErrBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ручка спойлера: компактная, без рамок, hover акцентом. -->
    <Style x:Key="FilesSpoilerToggle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource FilesTxt2Brush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource FilesAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Список: белый фон, без рамок, отступ 8. -->
    <Style x:Key="FilesList" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource FilesPanelBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- Строка списка: padding 10, без фокусной рамки,
         hover panel-2, selected — акцентная заливка + левая граница. -->
    <Style x:Key="FilesListItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource FilesPanel2Brush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource FilesAccentSoftBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource FilesAccentBrush}" />
                <Setter Property="BorderThickness" Value="3,0,0,0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Этап F.8: унификация «Заметок» и «Настроек» ===== -->
    <!-- Все цвета — только из палитры выше, новых hex в XAML нет. -->

    <!-- Карточка секции настроек: белый фон, radius 10, padding 16. -->
    <Style x:Key="CardSection" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FilesPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource FilesLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Заголовок секции: 15px bold (иконка — инлайн-эмодзи в разметке). -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource FilesTxtBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Однострочное поле ввода: тот же вид, что поиск (семантический алиас). -->
    <Style x:Key="FilesInputField" TargetType="TextBox"
           BasedOn="{StaticResource FilesSearchBox}" />

    <!-- Заголовок заметки: крупный, без рамки, при фокусе — акцентное подчеркивание. -->
    <Style x:Key="NoteTitleBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource FilesTxtBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource FilesAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Тело заметки: подложка panel-2, radius 8, padding 12;
         при фокусе — белая подложка и акцентная рамка. -->
    <Style x:Key="NoteBodyBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource FilesTxtBrush}" />
        <Setter Property="Background" Value="{StaticResource FilesPanel2Brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Background" Value="{StaticResource FilesPanelBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource FilesAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Чекбокс: плоский бокс 18px, при checked — индиго + белая галочка. -->
    <Style x:Key="MaterialCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource FilesTxtBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                BorderBrush="{StaticResource FilesLineBrush}"
                                BorderThickness="2"
                                Background="{StaticResource FilesPanelBrush}"
                                VerticalAlignment="Center">
                            <Path x:Name="Glyph" Data="M 4 9 L 8 13 L 14 4"
                                  Stroke="White" StrokeThickness="2" Stretch="Uniform"
                                  Margin="3" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource FilesAccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FilesAccentBrush}" />
                            <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FilesAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Маленькая Danger-кнопка (напр. «Отозвать»). -->
    <Style x:Key="FilesSmallDanger" TargetType="Button"
           BasedOn="{StaticResource FilesBtnDanger}">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Таб-пилюля на RadioButton: выбранная — акцент + белый текст. -->
    <Style x:Key="TabPill" TargetType="RadioButton">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FilesTxt2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{StaticResource FilesAccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource FilesPanel2Brush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- LED-индикатор статуса (цвет задается в разметке/триггерах). -->
    <Style x:Key="StatusLed" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Fill" Value="{StaticResource FilesTxt3Brush}" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- TabItem стилизован как таб: без стандартных границ, подчеркивание при выборе. -->
    <Style TargetType="TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource FilesTxt2Brush}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource FilesAccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource FilesPanel2Brush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>