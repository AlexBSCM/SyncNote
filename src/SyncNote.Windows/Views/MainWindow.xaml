<Window x:Class="SyncNote.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SyncNote.Windows.Views"
        Title="SyncNote" Height="600" Width="900" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: TOOLBAR -->
        <Border Grid.Row="0" Background="{StaticResource BgPrimaryBrush}"
                BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False" Margin="12,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="＋ Новая заметка" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddNoteCommand}"/>
                    <Button Content="⚙ Настройки" Style="{StaticResource DefaultButton}"
                            Margin="8,0,0,0" Command="{Binding OpenSettingsCommand}"/>
                    <Button Content="📱 Сопряжение..." Style="{StaticResource DefaultButton}"
                            Margin="8,0,0,0" Command="{Binding ShowPairingCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <RadioButton GroupName="Tabs" Content="Заметки"
                                 IsChecked="{Binding ShowNotes, Mode=TwoWay}"
                                 Style="{StaticResource TabStyle}"/>
                    <RadioButton GroupName="Tabs" Content="Файлы" Margin="4,0,0,0"
                                 IsChecked="{Binding ShowFiles, Mode=TwoWay}"
                                 Style="{StaticResource TabStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: LIST -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                    BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" Margin="12,12,12,8"
                             Style="{StaticResource SearchBoxStyle}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding Notes}"
                                 SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                                 Visibility="{Binding NotesVisible}"
                                 Background="Transparent" BorderThickness="0" Padding="8,0,8,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="📝" FontSize="16" VerticalAlignment="Center"
                                                   DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding Badge}" FontSize="13" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   DockPanel.Dock="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSynced}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OkFgBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Note.Title}" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Note.UpdatedAt}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox ItemsSource="{Binding Files}"
                                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                 Visibility="{Binding FilesVisible}"
                                 Background="Transparent" BorderThickness="0" Padding="8,0,8,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="📄" FontSize="16" VerticalAlignment="Center"
                                                   DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding Badge}" FontSize="13" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                                   DockPanel.Dock="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSynced}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource OkFgBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{Binding File.Name}" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="{Binding SizeText, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding File.Mime, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Нет данных" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextHintBrush}" FontSize="14"
                                   Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT: DETAILS -->
            <ContentControl Grid.Column="1" Content="{Binding SelectedNote}"
                            Visibility="{Binding NotesVisible}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Margin="0,0,0,12"
                                     Style="{StaticResource EditorTitle}"
                                     Text="{Binding Note.Title, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="B" FontWeight="Bold" Width="36"
                                        Style="{StaticResource DefaultButton}"
                                        Command="{Binding DataContext.FormatBoldCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding ElementName=BodyBox}"/>
                                <Button Content="I" FontStyle="Italic" Width="36" Margin="4,0,0,0"
                                        Style="{StaticResource DefaultButton}"
                                        Command="{Binding DataContext.FormatItalicCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding ElementName=BodyBox}"/>
                                <Button Content="☑ List" Margin="4,0,0,0"
                                        Style="{StaticResource DefaultButton}"
                                        Command="{Binding DataContext.FormatListCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Content="📎 Attach" Margin="4,0,0,0"
                                        Style="{StaticResource DefaultButton}"
                                        Command="{Binding DataContext.AttachFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton GroupName="NoteMode" Content="Редактирование"
                                             IsChecked="{Binding IsEditing, Mode=OneWay}"
                                             Style="{StaticResource TabStyle}"
                                             Command="{Binding DataContext.SetPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="0"/>
                                <RadioButton GroupName="NoteMode" Content="Просмотр" Margin="4,0,0,0"
                                             IsChecked="{Binding IsPreview, Mode=OneWay}"
                                             Style="{StaticResource TabStyle}"
                                             Command="{Binding DataContext.SetPreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                             CommandParameter="1"/>
                            </StackPanel>
                            <TextBox Grid.Row="3" x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource EditorBody}"
                                     Text="{Binding Note.Body, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibility}}"/>
                            <FlowDocumentScrollViewer Grid.Row="3"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="12" Background="{StaticResource BgPrimaryBrush}"
                                         Document="{Binding PreviewDocument}"
                                         Visibility="{Binding IsPreview, Converter={StaticResource BooleanToVisibility}}"/>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding DataContext.SaveNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                <Button Content="Удалить" Style="{StaticResource DefaultButton}"
                                        Margin="8,0,0,0" Foreground="{StaticResource ErrFgBrush}"
                                        Command="{Binding DataContext.DeleteNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>

            <ContentControl Grid.Column="1" Content="{Binding SelectedFile}"
                            Visibility="{Binding FilesVisible}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <ScrollViewer Margin="16">
                            <StackPanel>
                                <Border Style="{StaticResource CardSection}">
                                    <StackPanel>
                                        <TextBlock Text="📄 Информация о файле"
                                                   Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="{Binding File.Name}" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,8,0,0" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="{Binding SizeText}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding File.Mime}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding File.Sha256}" FontSize="11"
                                                   Foreground="{StaticResource TextHintBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding File.UpdatedAt}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Удалить" Style="{StaticResource DefaultButton}"
                                            Foreground="{StaticResource ErrFgBrush}"
                                            Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
