<Window x:Class="SyncNote.Windows.Views.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сопряжение с телефоном" Height="520" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Сопряжение с телефоном" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- QR код -->
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" 
                    Padding="16" Margin="0,0,0,16" Background="White"
                    Visibility="{Binding IsGeneratingQr, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Image Source="{Binding QrBitmap}" Width="240" Height="240" Stretch="Uniform"/>
                    <TextBlock Text="Отсканируйте QR в приложении SyncNote на телефоне" 
                               TextAlignment="Center" Margin="0,12,0,0" FontSize="13" 
                               Foreground="#666" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <TextBlock Text="IP: " FontWeight="Bold"/>
                        <TextBlock Text="{Binding HostIp}"/>
                        <TextBlock Text="  Порт: " FontWeight="Bold" Margin="16,0,0,0"/>
                        <TextBlock Text="{Binding Port}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Состояние ожидания -->
            <StackPanel Visibility="{Binding IsWaitingForPeer, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12" 
                             Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding StatusText}" TextAlignment="Center" 
                           FontSize="14" Foreground="#444" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Результат -->
            <StackPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Синхронизация завершена" FontSize="16" FontWeight="Bold" 
                           TextAlignment="Center" Foreground="#2E7D32" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding ResultSummary}" TextAlignment="Center" 
                           FontSize="13" Foreground="#666" TextWrapping="Wrap"/>
                <Button Content="Закрыть" Width="120" Margin="0,16,0,0" 
                        Command="{Binding CloseCommand}"/>
            </StackPanel>

            <!-- Ошибка -->
            <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Ошибка" FontSize="16" FontWeight="Bold" 
                           TextAlignment="Center" Foreground="#C62828" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding ErrorMessage}" TextAlignment="Center" 
                           FontSize="13" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <Button Content="Попробовать снова" Width="160" 
                        Command="{Binding RetryCommand}"/>
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="2" Content="Сгенерировать QR-код" Height="40" 
                Command="{Binding StartPairingCommand}" 
                Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}"
                Margin="0,16,0,0" Padding="24,8"/>
    </Grid>
</Window>